# ==============================================================================
# workbench/arc_live_animation.cxc
# Title: Live Turntable Animation of PDB 6TAP (dArc1 Capsid + Interior NC/Zn)
# Epistemic Status: [MEASURED GEOMETRY FROM DEPOSITED COORDINATES - NO MECHANISM CLAIMED]
# Compatible with UCSF ChimeraX 1.12. Strictly zero em-dashes and zero en-dashes.
# ==============================================================================

close session
windowsize 1600 960
set bgColor #080d14
graphics silhouettes true
lighting soft

open structures/6TAP.cif
sym #1 assembly 1 copies true

hide #1 atoms
show #1 cartoons
color #1/A-D #38bdf8
transparency #1/A-D 58 cartoons
color #1/E #ec4899
transparency #1/E 0 cartoons
show #1/F atoms
style #1/F sphere
color #1/F #facc15
size #1/F atomRadius 3.5

view orient
zoom 1.05

2dlabels create title_hud text "AHRT v0.1 Live Animation: PDB 6TAP dArc1 Capsid + Interior NC/Zn Geometry [MEASURED GEOMETRY]" xpos 0.02 ypos 0.95 size 15 color #f8fafc
2dlabels create sub_hud text "Two Populations (300 chains): 240 CA shell (Chains A-D, T=4, blue, R_out=19.93 nm) + 60 interior NC Zn-knuckle (Chain E, pink) + 60 Zn2+ (Chain F, yellow)" xpos 0.02 ypos 0.90 size 12 color #94a3b8
2dlabels create axes_hud text "Scale Regime: Photon attenuation ~1e-6 (transparent); active regime is ~1 keV e- tracks (~50 nm) & OH radical scavenging across CA shell / 60 Zn sites" xpos 0.02 ypos 0.03 size 12 color #38bdf8

# Orbit on the verified 5-fold, 3-fold, and 2-fold icosahedral axes, then continuous roll
turn 0.276393,-0.850651,-0.447213 1.0 360 coordinateSystem #1
wait 360
turn 0.303531,0.934172,0.187592 1.0 360 coordinateSystem #1
wait 360
turn 0.688191,0.500000,-0.525731 1.0 360 coordinateSystem #1
wait 360
roll y 0.6

    "voronoi_vs_bsa_geometric_distinction_and_linear_calibration": {
      "geometric_distinction_note": "Voronoi radical-plane contact area (sum = 4236.73 A^2 across the 10 representative sub-interfaces) measures the area of the single dividing radical-plane polygon mosaic shared between two contacting subunits within the solvent-accessible shell, whereas two-sided pairwise BSA (9570.22 A^2 Shrake-Rupley / 9400.64 A^2 Lee-Richards) sums the curved solvent-excluded surface patches on both partner subunits (and one-side BSA = 4785.10 A^2 is half of the two-sided pairwise BSA). Thus Voronoi contact area scales as ~0.445x two-sided pairwise BSA (~0.890x one-side BSA) with R^2 = 0.9984.",
      "ols_vs_two_sided_shrake_rupley_pairwise_bsa": {
        "formula": "voronoi_A2 = slope * sr_pairwise_bsa_A2 + intercept_A2",
        "slope": 0.444876,
        "intercept_A2": -2.0833,
        "r_squared": 0.998367,
        "rmse_A2": 11.1209,
        "max_abs_residual_A2": 24.143
      },
      "ols_vs_one_side_shrake_rupley_bsa": {
